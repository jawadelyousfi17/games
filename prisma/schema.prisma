// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  login           String          @unique
  email           String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  image           String?
  name            String?
  campus          Campus
  role            Role
  emailVerified   DateTime?
  isEmailVerified Boolean         @default(false)
  accounts        Account[]
  Authenticator   Authenticator[]

  sessions  Session[]

  whiteGames        ChessGame[]        @relation("WhiteGames")
  blackGames        ChessGame[]        @relation("BlackGames")
  chessQueueTicket  ChessQueueTicket?
  chessRating       ChessRating?
  chessMessages     ChessChatMessage[]

  challengesSent     ChessChallenge[] @relation("ChallengesSent")
  challengesReceived ChessChallenge[] @relation("ChallengesReceived")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Token {
  id           String   @id @default(uuid())
  acessToken   String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Campus {
  KHOURIBGA
  BEN_GUERIR
  RABAT
  TETOUANE
}

enum Role {
  STUDENT
  ADMIN
  STAFF
}

// ---------------------------------------------------------------------------
// Chess models
// ---------------------------------------------------------------------------

enum ChessGameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ChessResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum ChessEndReason {
  CHECKMATE
  RESIGN
  TIMEOUT
  STALEMATE
  DRAW_INSUFFICIENT
  DRAW_THREEFOLD
  DRAW_FIFTY_MOVE
  DRAW_AGREED
  ABORT
  DISCONNECT
}

model ChessGame {
  id           String          @id @default(cuid())
  whiteId      String
  blackId      String
  white        User            @relation("WhiteGames", fields: [whiteId], references: [id], onDelete: Cascade)
  black        User            @relation("BlackGames", fields: [blackId], references: [id], onDelete: Cascade)
  fen          String          @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn          String          @default("")
  status       ChessGameStatus @default(IN_PROGRESS)
  result       ChessResult?
  endReason    ChessEndReason?

  // Time control + per-color clocks (server-authoritative, milliseconds).
  initialMs    Int             @default(300000)
  incrementMs  Int             @default(0)
  whiteMs      Int             @default(300000)
  blackMs      Int             @default(300000)

  lastMoveAt   DateTime        @default(now())
  startedAt    DateTime        @default(now())
  endedAt      DateTime?

  /** User id of whoever has an open draw offer; null when no offer pending.
   *  Auto-cleared on any move and on accept/decline. */
  drawOfferedBy String?

  // Snapshot of ratings at game start; "after" populated on finalize.
  whiteRatingBefore Int        @default(1200)
  blackRatingBefore Int        @default(1200)
  whiteRatingAfter  Int?
  blackRatingAfter  Int?

  moves        ChessMove[]
  messages     ChessChatMessage[]

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
}

model ChessMove {
  id        String    @id @default(cuid())
  gameId    String
  game      ChessGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply       Int
  san       String
  uci       String
  fenAfter  String
  msSpent   Int
  createdAt DateTime  @default(now())

  @@unique([gameId, ply])
  @@index([gameId])
}

model ChessQueueTicket {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialMs   Int      @default(300000)
  incrementMs Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum ChessChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model ChessChallenge {
  id            String               @id @default(cuid())
  challengerId  String
  challengedId  String
  initialMs     Int                  @default(300000)
  incrementMs   Int                  @default(0)
  status        ChessChallengeStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  resolvedAt    DateTime?
  gameId        String?
  challenger    User @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged    User @relation("ChallengesReceived", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengedId, status])
  @@index([challengerId, status])
}

model ChessChatMessage {
  id        String    @id @default(cuid())
  gameId    String
  userId    String
  body      String    @db.VarChar(500)
  createdAt DateTime  @default(now())
  game      ChessGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
}

model ChessRating {
  userId    String   @id
  rating    Int      @default(1200)
  games     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
